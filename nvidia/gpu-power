#!/usr/bin/env bash
# Nothing Liquid: the NVIDIA GPU of a laptop, off whenever nothing uses it.
#
# NVIDIA's runtime power management (NVreg_DynamicPowerManagement=0x02, from
# nvidia/install.sh) cuts the GPU's power (D3cold, 0 W) whenever no app uses it, and
# turns it on again for the app that does, in every power profile. The GPU stays
# visible all the time, so every app and service finds it, whenever it starts.
# This follows the power profile (power-profiles-daemon) for the one thing left:
#
#   performance   NVIDIA's Dynamic Boost (nvidia-powerd), which shifts power from the
#                 CPU to the GPU under load; off in balanced and power saver
#
#   gpu-power           follow the profile (nothing-liquid-gpu-power.service, as root)
#   gpu-power status    what the GPU is doing now, and what's using it (as anyone)
#   gpu-power on        put back a GPU that an earlier version took off the bus (as root)
set -uo pipefail
shopt -s nullglob

RUN=/run/nothing-liquid
REMOVED="$RUN/gpu-removed"   # (earlier versions took the GPU off the bus in power saver)
STATE="$RUN/gpu-state"       # on-demand | boost

log() { echo "$*"; }         # (to the journal)

# The NVIDIA display controllers (class 0x03xxxx), as PCI addresses
nvidia_gpus() {
  local d
  for d in /sys/bus/pci/devices/*; do
    [[ "$(<"$d/vendor")" == 0x10de && "$(<"$d/class")" == 0x03* ]] && echo "${d##*/}"
  done
}

# The programs using the GPU: holding NVIDIA's /dev/nvidia<N> open (as root, all of
# them; as you, yours). Hyprland's idle handle on the display node doesn't count.
users() {
  local pid
  find /proc/[0-9]*/fd -maxdepth 1 -lname '/dev/nvidia[0-9]*' -printf '%h\n' 2>/dev/null \
    | cut -d/ -f3 | sort -u | while read -r pid; do
      cat "/proc/$pid/comm" 2>/dev/null
    done | sort -u | paste -sd' '
}

powerd() {  # Dynamic Boost on or off, where the driver has it
  systemctl cat nvidia-powerd.service >/dev/null 2>&1 || return 0
  if [[ "$1" == on ]]; then systemctl start nvidia-powerd.service; else systemctl stop nvidia-powerd.service; fi
}

gpu_on() {
  [[ -s "$REMOVED" ]] || return 0
  local port
  read -r port _ < "$REMOVED"
  log "bringing back the GPU an earlier version took off the bus"
  if [[ -e "/sys/bus/pci/devices/$port/rescan" ]]; then
    echo 1 > "/sys/bus/pci/devices/$port/rescan"
  else
    echo 1 > /sys/bus/pci/rescan
  fi
  rm -f "$REMOVED"
}

profile() { powerprofilesctl get 2>/dev/null || echo balanced; }

apply() {
  if [[ "$1" == performance ]]; then
    powerd on; echo boost > "$STATE"
  else
    powerd off; echo on-demand > "$STATE"
  fi
}

status() {
  local gpus g who mode
  mode="$(cat "$STATE" 2>/dev/null || echo "not running")"
  echo "power profile:  $(profile)"
  case "$mode" in
    on-demand) echo "GPU setting:    off whenever nothing uses it" ;;
    boost) echo "GPU setting:    off whenever nothing uses it; Dynamic Boost on" ;;
    *) echo "GPU setting:    $mode" ;;
  esac
  mapfile -t gpus < <(nvidia_gpus)
  if ((${#gpus[@]} == 0)); then
    echo "GPU:            no NVIDIA GPU found"
    return
  fi
  g="/sys/bus/pci/devices/${gpus[0]}"
  echo "GPU ${gpus[0]}: $(<"$g/power/runtime_status") ($(<"$g/power_state"))" \
       "- on for $(( $(<"$g/power/runtime_active_time") / 1000 ))s," \
       "off for $(( $(<"$g/power/runtime_suspended_time") / 1000 ))s since it started"
  who="$(users)"
  echo "using it now:   ${who:-nothing}$( ((EUID)) && echo " (of your programs)")"
}

case "${1:-}" in
  status) status; exit 0 ;;
  on) gpu_on; exit 0 ;;
  "") ;;
  *) echo "usage: gpu-power [status|on]" >&2; exit 2 ;;
esac

# ── follow the profile ───────────────────────────────────────────────────────
mkdir -p "$RUN"
gpu_on
current="$(profile)"
log "power profile: $current"
apply "$current"

# Every change of profile, as power-profiles-daemon announces it on D-Bus; and
# when the daemon itself (re)starts, which may be after this
coproc WATCH { exec gdbus monitor --system --dest net.hadess.PowerProfiles --object-path /net/hadess/PowerProfiles; }
while read -r line <&"${WATCH[0]}"; do
  [[ "$line" == *ActiveProfile* || "$line" == *"is owned by"* ]] || continue
  new="$(profile)"
  [[ "$new" == "$current" ]] && continue
  current="$new"
  log "power profile: $current"
  apply "$current"
done
log "lost power-profiles-daemon; starting over"
exit 1   # (systemd restarts it)
