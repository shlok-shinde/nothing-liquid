        expander.set_child(self.log_scroll)
        box.append(expander)
        self.stop_button = Gtk.Button(label="Stop", halign=Gtk.Align.END)
        self.stop_button.add_css_class("flat")
        self.stop_button.connect("clicked", lambda *_: self.ask_stop())
        box.append(self.stop_button)
        title = {"remove": "Removing", "update": "Updating"}.get(self.choices.mode, "Installing")
        self.progress_page = page(title, box, "progress", can_pop=False)
        self.nav.push(self.progress_page)

        stamp = time.strftime("%Y%m%d-%H%M%S")
        self.log_path = LOGS / f"{self.choices.mode}-{stamp}{'-demo' if DEMO else ''}.log"
        self.started = time.time()
        self.running = True
        self.index = 0
        self.pending_live = None
        self.runner = Runner(self.log_path, self.on_line, self.on_live, self.on_ready, self.on_done,
                             self.on_prompt, self.on_exit)
        self.runner.log.write(f"Nothing Liquid installer, {time.ctime()}: {self.choices}\n")
        self.runner.start()
        GLib.timeout_add(500, self.tick)

    def on_ready(self):
        self.next_step()

    def next_step(self):
        if self.index >= len(self.steps):
            self.finish(True)
            return
        st = self.steps[self.index]
        st.started = time.time()
        visible = [x for x in self.steps if x.key != "finish"]
        n = visible.index(st) + 1 if st in visible else len(visible)
        self.kicker.set_label(f"STEP {n} OF {len(visible)}")
        self.step_title.set_label(st.title)
        self.step_detail.set_label(st.detail)
        self.duration.set_label(f"· {st.duration}" if st.duration else "")
        self.on_line(f"── {st.title} ──")
        self.runner.recent = []
        self.runner.log.write(f"$ {st.command}\n")
        self.runner.run(st.command)

    def tick(self):
        if not self.running:
            return False
        total = sum(st.seconds for st in self.steps) or 1
        done = sum(st.seconds for st in self.steps[:self.index])
        if self.index < len(self.steps):
            st = self.steps[self.index]
            done += st.seconds * min(0.92, (time.time() - st.started) / max(st.seconds, 1)) if st.started else 0
        self.dots.set_fraction(done / total)
        mins, secs = divmod(int(time.time() - self.started), 60)
        self.elapsed.set_label(f"{mins}:{secs:02d}")
        return True

    def on_done(self, code):
        self.drop_dialog()
        if not self.running:
            return
        st = self.steps[self.index]
        if code == 0:
            st.done = True
            self.index += 1
            self.next_step()
            return
        self.runner.log.write(f"(step {st.key} ended with {code})\n")
        if st.key == "glass" and any("you have edited" in line for line in self.runner.recent):
            self.ask_overwrite(st)
        else:
            self.show_failed(st, code)

    def on_exit(self):
        if self.running:
            self.running = False
            if not self.closing:
                st = self.steps[min(self.index, len(self.steps) - 1)]
                self.show_failed(st, -1)

    # ── the log ──
    def on_line(self, line):
        end = self.buffer.get_end_iter()
        self.buffer.delete(self.buffer.get_iter_at_mark(self.live_mark), end)
        self.buffer.insert(self.buffer.get_end_iter(), line + "\n")
        self.buffer.move_mark(self.live_mark, self.buffer.get_end_iter())
        lines = self.buffer.get_line_count()
        if lines > 6000:
            self.buffer.delete(self.buffer.get_start_iter(), self.buffer.get_iter_at_line(lines - 5000)[1])
        self.scroll_log()

    def on_live(self, text):
        # Throttled: progress bars redraw many times a second
        first = self.pending_live is None
        self.pending_live = text
        if first:
            GLib.timeout_add(100, self.flush_live)

    def flush_live(self):
        text, self.pending_live = self.pending_live, None
        if text is None:
            return False
        self.buffer.delete(self.buffer.get_iter_at_mark(self.live_mark), self.buffer.get_end_iter())
        self.buffer.insert(self.buffer.get_end_iter(), text.replace(SUDO_MARK, "[password]"))
        self.scroll_log()
        return False

    def scroll_log(self):
        adj = self.log_scroll.get_vadjustment()
        if adj.get_upper() - adj.get_page_size() - adj.get_value() < 80:
            GLib.idle_add(lambda: self.logview.scroll_to_mark(self.live_mark, 0, False, 0, 1) and False)

    # ── questions from the terminal ──
    def on_prompt(self, kind, text, recent, token):
        self.token = token
        question = re.sub(r"^\s*(::|==>|->)\s*", "", text).strip()
        if kind == "password":
            self.ask_password(any("Sorry, try again" in line for line in recent[-3:]))
        elif kind == "yesno":
            if re.search(r"Proceed with (installation|download)\?", text):
                self.runner.answer("y", token)  # what you agreed to on the last page
                return
            default_yes = "[Y/" in text
            body = re.sub(r"\s*\[[YyNn]/[YyNn]\]:?$", "", question)
            self.ask("The package manager is asking", body + "\n\nIf you're not sure, the highlighted answer is "
                     "its own suggestion.", [("n", "No"), ("y", "Yes")], "y" if default_yes else "n")
        elif kind == "failure":
            tail = "\n".join(line for line in recent[-12:] if line.strip())
            self.ask("A command didn't work", "Often it's a download that broke off: trying again usually works. "
                     "Skipping it can leave part of the desktop not working.",
                     [("e", "Stop"), ("i", "Skip it"), ("r", "Try again")], "r", detail=tail,
                     appearance={"i": Adw.ResponseAppearance.DESTRUCTIVE})
        else:
            self.ask_text(question)

    def reply(self, text, secret=False):
        self.dialog = None
        if self.runner:
            self.runner.answer(text, self.token, secret)

    def show_dialog(self, dialog):
        self.drop_dialog()
        self.dialog = dialog
        dialog.present(self)

    def drop_dialog(self):
        # The question it answered is gone (the step ended): don't leave it up
        if self.dialog:
            dialog, self.dialog = self.dialog, None
            dialog.force_close()

    def ask(self, heading, body, responses, default, detail=None, appearance=None):
        dialog = Adw.AlertDialog(heading=heading, body=body)
        for rid, text in responses:
            dialog.add_response(rid, text)
        dialog.set_response_appearance(default, Adw.ResponseAppearance.SUGGESTED)
        for rid, look in (appearance or {}).items():
            dialog.set_response_appearance(rid, look)
        dialog.set_default_response(default)
        dialog.set_close_response(default)
        if detail:
            dialog.set_extra_child(self.detail_box(detail))
        dialog.connect("response", lambda d, rid: self.dialog is d and self.reply(rid))
        self.show_dialog(dialog)

    def detail_box(self, text):
        view = label(text, "nl-log", selectable=True)
        sc = Gtk.ScrolledWindow(min_content_height=120, max_content_height=220, propagate_natural_height=True)
        sc.set_child(view)
        sc.add_css_class("nl-logbox")
        return sc

    def ask_password(self, retry):
        body = ("That password didn't work. Try again: it's the one you use to log in to this computer."
                if retry else "To install system parts, the installer needs the password you use to log in "
                "to this computer. It goes to the system (sudo) and nowhere else.")
        if DEMO:
            body += "\n\n(Demo: type anything.)"
        dialog = Adw.AlertDialog(heading="Your password", body=body)
        entry = Gtk.PasswordEntry(show_peek_icon=True, activates_default=True)
        dialog.set_extra_child(entry)
        dialog.add_response("cancel", "Cancel")
        dialog.add_response("ok", "Continue")
        dialog.set_response_appearance("ok", Adw.ResponseAppearance.SUGGESTED)
        dialog.set_default_response("ok")
        dialog.set_close_response("cancel")

        def response(d, rid):
            if self.dialog is not d:
                return
            if rid == "ok":
                self.reply(entry.get_text(), secret=True)
            else:
                self.dialog = None
                if self.runner:
                    self.runner.interrupt()
            entry.set_text("")
        dialog.connect("response", response)
        self.show_dialog(dialog)
        entry.grab_focus()

    def ask_text(self, question):
        dialog = Adw.AlertDialog(heading="A question from the installer",
                                 body=question + "\n\nLeave it empty to take its default answer.")
        entry = Gtk.Entry(activates_default=True)
        dialog.set_extra_child(entry)
        dialog.add_response("ok", "Answer")
        dialog.set_response_appearance("ok", Adw.ResponseAppearance.SUGGESTED)
        dialog.set_default_response("ok")
        dialog.set_close_response("ok")
        dialog.connect("response", lambda d, rid: self.dialog is d and self.reply(entry.get_text()))
        self.show_dialog(dialog)
        entry.grab_focus()

    def ask_overwrite(self, st):
        edited = [re.sub(r"^.*you have edited (\S+) yourself.*$", r"\1", line) for line in self.runner.recent
                  if "you have edited" in line]
        dialog = Adw.AlertDialog(
            heading="You've changed some of these files",
            body="Nothing Liquid would replace files you have edited yourself. Replace them anyway? "
                 "Your versions are kept in ~/.local/share/nothing-liquid, so you can copy your changes back.")
        dialog.set_extra_child(self.detail_box("\n".join(edited)))
        dialog.add_response("stop", "Stop")
        dialog.add_response("force", "Replace them")
        dialog.set_response_appearance("force", Adw.ResponseAppearance.SUGGESTED)
        dialog.set_default_response("force")
        dialog.set_close_response("stop")

        def response(d, rid):
            if rid == "force":
                st.command += " --force"
                self.next_step()
            else:
                self.show_failed(st, 1)
        dialog.connect("response", response)
        dialog.present(self)

    # ── stopping ──
    def ask_stop(self, then_close=False):
        dialog = Adw.AlertDialog(heading="Stop now?",
                                 body="What's done so far stays done, and it may leave the desktop half set up. "
                                      "Run the installer again to finish, or to remove it.")
        dialog.add_response("keep", "Keep going")
        dialog.add_response("stop", "Stop")
        dialog.set_response_appearance("stop", Adw.ResponseAppearance.DESTRUCTIVE)
        dialog.set_default_response("keep")
        dialog.set_close_response("keep")

        def response(d, rid):
            if rid != "stop" or not self.running:
                return
            self.running = False
            self.runner.log.write("(stopped by you)\n")
            self.runner.interrupt()
            if then_close:
                self.closing = True
                self.runner.close()
                self.runner = None
                self.close()
            else:
                self.show_failed(self.steps[self.index], -2)
        dialog.connect("response", response)
        dialog.present(self)

    def on_close_request(self, *_):
        if self.running:
            self.ask_stop(then_close=True)
            return True
        if self.runner:
            self.runner.close()
            self.runner = None
        return False

    # ── the end ──
    def finish(self, ok):
        self.running = False
        self.dots.set_fraction(1)
        if not DEMO and not DRY:
            self.install_launcher()
        if self.runner:
            self.runner.close()
            self.runner = None
        self.show_done()

    def install_launcher(self):
        # So it can be found again in the apps menu, to update or remove
        apps = Path(os.environ.get("XDG_DATA_HOME") or HOME / ".local/share") / "applications"
        apps.mkdir(parents=True, exist_ok=True)
        exe = Path(__file__).resolve()
        if self.choices.mode == "remove":
            return
        (apps / f"{APP_ID}.desktop").write_text(
            "[Desktop Entry]\nType=Application\nName=Nothing Liquid\n"
            "Comment=Install, update or remove the Nothing Liquid desktop\n"
            f"Exec=python3 \"{exe}\"\nIcon={HERE / 'icon.svg'}\nTerminal=false\nCategories=System;Settings;\n")

    def show_done(self):
        c, s = self.choices, self.system
        box = column(16)
        dot = Gtk.Box(halign=Gtk.Align.CENTER)
        dot.add_css_class("nl-dot")
        box.append(dot)
        if c.mode == "remove":
            box.append(label("REMOVED", "nl-title", xalign=0.5))
            box.append(label("Your files are back as they were. Hyprland and end-4's desktop are still installed: "
                             "at the login screen you can pick your previous desktop.", "nl-lead", xalign=0.5))
        else:
            box.append(label("ALL SET", "nl-title", xalign=0.5))
            if s["in_hyprland"]:
                box.append(label("It's on. Look around: try the dock, or open a terminal.", "nl-lead", xalign=0.5))
            else:
                box.append(label("Nothing Liquid is installed.", "nl-lead", xalign=0.5))
                steps = Adw.PreferencesGroup(title="To start it")
                for i, (t, sub) in enumerate([
                        ("Save your work and log out", "Or restart the computer."),
                        ("Choose Hyprland on the login screen", "Look for the session menu: usually a button near "
                         "your name or in a corner of the screen."),
                        ("Log in", "The first start takes a few seconds while it sets up its colours.")], 1):
                    row = Adw.ActionRow(title=t, subtitle=sub)
                    row.set_subtitle_lines(0)
                    row.add_prefix(label(f"{i:02d}", "nl-num", wrap=False))
                    steps.add(row)
                box.append(steps)
            keys = Adw.PreferencesGroup(title="A few keys to start with",
                                        description="SUPER is the key with the Windows or Command logo.")
            for k, what in KEYS:
                row = Adw.ActionRow(title=what)
                chip = label(k, "nl-key", wrap=False)
                chip.set_valign(Gtk.Align.CENTER)
                row.add_suffix(chip)
                keys.add(row)
            box.append(keys)
        buttons = Gtk.Box(spacing=12, halign=Gtk.Align.CENTER)
        if c.mode != "remove" and not s["in_hyprland"] and not (DEMO or DRY):
            out_b = big_button("Log out now")
            out_b.connect("clicked", lambda *_: self.ask_logout())
            buttons.append(out_b)
            close = big_button("Later", "flat")
        else:
            close = big_button("Close")
        close.connect("clicked", lambda *_: self.close())
        buttons.append(close)
        box.append(buttons)
        log = Gtk.Button(label="Open the log", halign=Gtk.Align.CENTER)
        log.add_css_class("flat")
        log.connect("clicked", lambda *_: self.open_log())
        box.append(log)
        p = page("Done", box, "done", can_pop=False, header_title=False)
        p.connect("shown", lambda *_: buttons.get_first_child().grab_focus())
        self.nav.push(p)

    def show_failed(self, st, code):
        self.running = False
        self.drop_dialog()
        box = column(16)
        by_you = code in (-2, 130)
        box.append(label("STOPPED" if by_you else "THAT DIDN'T WORK", "nl-title", xalign=0.5))
        box.append(label(f"“{st.title}” stopped" + (" because you asked it to." if by_you else ".") +
                         " Nothing after it has run, and your settings are backed up.", "nl-lead", xalign=0.5))
        tail = [line for line in (self.runner.recent if self.runner else []) if line.strip()][-14:]
        if tail and not by_you:
            box.append(self.detail_box("\n".join(tail)))
        if st.key in ("deps", "tools", "font", "pull") and not by_you:
            box.append(label("Usually that's the internet connection or a busy download server: "
                             "check you're online and try again.", "dim-label", xalign=0.5))
        buttons = Gtk.Box(spacing=12, halign=Gtk.Align.CENTER)
        retry = big_button("Try again")
        retry.connect("clicked", lambda *_: self.retry(st))
        buttons.append(retry)
        if st.skippable and not by_you:
            skip = big_button("Skip this step", "flat")
            skip.set_tooltip_text(st.skip_note)
            skip.connect("clicked", lambda *_: self.retry(st, skip=True))
            buttons.append(skip)
        close = big_button("Close", "flat")
        close.connect("clicked", lambda *_: self.close())
        buttons.append(close)
        box.append(buttons)
        if st.skippable and st.skip_note:
            box.append(label(st.skip_note, "caption", "dim-label", xalign=0.5))
        log = Gtk.Button(label="Open the full log", halign=Gtk.Align.CENTER)
        log.add_css_class("flat")
        log.connect("clicked", lambda *_: self.open_log())
        box.append(log)
        p = page("Stopped", box, "failed", can_pop=False)
        p.connect("shown", lambda *_: retry.grab_focus())
        self.nav.push(p)

    def retry(self, st, skip=False):
        self.nav.pop_to_tag("progress")
        if skip:
            self.on_line(f"(skipped: {st.title})")
            self.index += 1
        if not self.runner:  # the session ended (stopped or closed): a new one
            self.runner = Runner(self.log_path, self.on_line, self.on_live, self.on_ready, self.on_done,
                                 self.on_prompt, self.on_exit)
            self.running = True
            self.runner.start()
            GLib.timeout_add(500, self.tick)
            return
        self.running = True
        GLib.timeout_add(500, self.tick)
        self.next_step()

    def ask_logout(self):
        dialog = Adw.AlertDialog(heading="Log out now?",
                                 body="Apps that are open will close: save your work first.")
        dialog.add_response("cancel", "Cancel")
        dialog.add_response("out", "Log out")
        dialog.set_response_appearance("out", Adw.ResponseAppearance.SUGGESTED)
        dialog.set_default_response("out")
        dialog.set_close_response("cancel")

        def response(d, rid):
            if rid == "out":
                session = os.environ.get("XDG_SESSION_ID")
                cmd = ["loginctl", "terminate-session", session] if session else ["loginctl", "terminate-user", os.environ.get("USER", "")]
                subprocess.Popen(cmd)
        dialog.connect("response", response)
        dialog.present(self)

    def open_log(self):
        if self.log_path and self.log_path.exists():
            Gtk.FileLauncher.new(Gio.File.new_for_path(str(self.log_path))).launch(self, None, None)

    @staticmethod
    def short(path):
        p = str(path)
        return "~" + p[len(str(HOME)):] if p.startswith(str(HOME)) else p


class App(Adw.Application):
    def __init__(self):
        super().__init__(application_id=APP_ID,
                         flags=Gio.ApplicationFlags.NON_UNIQUE)
        self.connect("activate", self.on_activate)

    def on_activate(self, app):
        Adw.StyleManager.get_default().set_color_scheme(Adw.ColorScheme.PREFER_DARK)
        css = Gtk.CssProvider()
        css.load_from_string(CSS)
        Gtk.StyleContext.add_provider_for_display(Gdk.Display.get_default(), css,
                                                  Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION)
        Gtk.Window.set_default_icon_name("system-software-install")
        Window(self).present()


if __name__ == "__main__":
    sys.exit(App().run([a for a in sys.argv if not a.startswith("--")]))
