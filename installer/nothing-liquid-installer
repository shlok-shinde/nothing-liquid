# ── what this computer has ───────────────────────────────────────────────────
def out(cmd, timeout=10):
    try:
        return subprocess.run(cmd, capture_output=True, text=True, timeout=timeout).stdout
    except (OSError, subprocess.SubprocessError):
        return ""


def version(text, pattern):
    m = re.search(pattern, text, re.M)
    return tuple(int(x) for x in m.group(1).split(".")) if m else None


def vstr(v):
    return ".".join(map(str, v)) if v else ""


def reachable(host):
    try:
        socket.create_connection((host, 443), timeout=4).close()
        return True
    except OSError:
        return False


def detect():
    s = {}
    release = {}
    try:
        for line in open("/etc/os-release"):
            k, _, v = line.strip().partition("=")
            release[k] = v.strip('"')
    except OSError:
        pass
    s["distro"] = release.get("PRETTY_NAME") or release.get("NAME") or "Linux"
    ids = (release.get("ID", "") + " " + release.get("ID_LIKE", "")).split()
    s["arch"] = "arch" in ids or shutil.which("pacman") is not None
    s["root"] = os.geteuid() == 0
    s["online"] = reachable("github.com") or reachable("archlinux.org")
    s["free_root"] = shutil.disk_usage("/").free / 1e9
    s["hypr_installed"] = version(out(["Hyprland", "--version"]), r"Hyprland\s+(\d+\.\d+(?:\.\d+)?)")
    s["hypr_repo"] = version(out(["pacman", "-Si", "hyprland"]), r"^Version\s*:\s*(\d+\.\d+(?:\.\d+)?)")
    vendors = {"0x10de": "NVIDIA", "0x8086": "Intel", "0x1002": "AMD"}
    s["gpus"] = []
    for path in sorted(glob.glob("/sys/class/drm/card[0-9]*/device/vendor")):
        try:
            name = vendors.get(open(path).read().strip(), "Other")
        except OSError:
            continue
        if name not in s["gpus"]:
            s["gpus"].append(name)
    s["nvidia_driver"] = os.path.isdir("/sys/module/nvidia") or bool(out(["pacman", "-Q", "nvidia-utils"]))
    # A laptop's NVIDIA GPU next to the integrated one: nvidia/install.sh sets it up
    s["nvidia_hybrid"] = "NVIDIA" in s["gpus"] and len(s["gpus"]) > 1
    s["gpu_power"] = os.path.exists(GPU_POWER_UNIT)
    s["end4"] = (HOME / ".config/quickshell/ii/shell.qml").exists()
    s["nl"] = (HOME / ".local/lib/nothing-liquid/hyprglass.so").exists() or (STATE / "original").exists()
    dm = os.path.basename(os.path.realpath("/etc/systemd/system/display-manager.service"))
    s["dm"] = dm[:-len(".service")] if dm.endswith(".service") else None
    s["login_theme"] = LOGIN_THEME.exists()
    s["power_key"] = os.path.exists(POWER_KEY_CONF)
    s["in_hyprland"] = bool(os.environ.get("HYPRLAND_INSTANCE_SIGNATURE"))
    s["kde"] = "KDE" in os.environ.get("XDG_CURRENT_DESKTOP", "") or shutil.which("plasmashell") is not None
    s["build_tools"] = all(shutil.which(x) for x in ("make", "g++", "pkg-config")) and os.path.isdir("/usr/include/hyprland")
    s["doto"] = "doto" in out(["fc-list", ":", "family"]).lower()
    return s


@dataclass
class Check:
    title: str
    level: str  # ok | info | warn | fail
    detail: str


def checks(s):
    c = []
    if s["arch"]:
        c.append(Check("Arch-based Linux", "ok", f"{s['distro']}"))
    else:
        c.append(Check("Arch-based Linux", "fail",
                       f"Nothing Liquid installs its parts with pacman, on Arch Linux and the distros built on it "
                       f"(EndeavourOS, CachyOS, Garuda, Manjaro). {s['distro']} isn't one of them."))
    if s["root"]:
        c.append(Check("Your own account", "fail",
                       "The installer is running as the administrator (root). Start it as yourself: "
                       "it asks for your password when it needs it."))
    c.append(Check("Internet", "ok", "Connected") if s["online"] else
             Check("Internet", "fail", "No connection. The installer downloads the desktop: connect and check again."))
    if s["free_root"] >= 8:
        c.append(Check("Free space", "ok", f"{s['free_root']:.0f} GB free"))
    else:
        c.append(Check("Free space", "warn", f"Only {s['free_root']:.1f} GB free; a fresh install can need 8 GB."))
    have, repo = s["hypr_installed"], s["hypr_repo"]
    v = have or repo
    word = "installed" if have else "will be installed"
    if not v:
        if s["arch"]:
            c.append(Check("Hyprland", "warn", "Couldn't tell which Hyprland your distro offers."))
    elif v[:2] == HYPRLAND_TARGET:
        c.append(Check("Hyprland", "ok", f"{vstr(v)} {word}: the version Nothing Liquid is made for"))
    elif v[:2] < HYPRLAND_TARGET:
        c.append(Check("Hyprland", "fail" if not s["end4"] else "warn",
                       f"{vstr(v)} {word}, but this setup needs 0.56 or newer. "
                       "Update your system (sudo pacman -Syu) and check again."))
    else:
        c.append(Check("Hyprland", "warn",
                       f"{vstr(v)} {word}. Nothing Liquid is made for 0.56: the desktop works, but the glass "
                       "effects may not load until they're updated for this version."))
    gpus = s["gpus"]
    if s["nvidia_hybrid"]:
        c.append(Check("Graphics", "ok", " + ".join(gpus) + (
            "" if s["nvidia_driver"] else ": NVIDIA's driver goes in with the rest")))
    elif "NVIDIA" in gpus and not s["nvidia_driver"]:
        c.append(Check("Graphics", "warn",
                       "An NVIDIA card without NVIDIA's driver. Hyprland needs it: install your distro's NVIDIA "
                       "driver first (for example nvidia-open), restart, and run the installer again."))
    elif gpus:
        c.append(Check("Graphics", "ok", " + ".join(gpus)))
    if s["nl"]:
        c.append(Check("Your desktop", "info", "Nothing Liquid is installed: you can update or remove it."))
    elif s["end4"]:
        c.append(Check("Your desktop", "info", "end-4's desktop is installed: the glass can go on top of it."))
    if s["dm"] == "sddm":
        c.append(Check("Login screen", "ok", "SDDM: it can get the Nothing Liquid login screen"))
    elif s["dm"]:
        c.append(Check("Login screen", "info",
                       f"{s['dm'].upper()}: the Nothing Liquid login screen needs SDDM, so yours stays as it is."))
    return c


# ── the steps ────────────────────────────────────────────────────────────────
@dataclass
class Step:
    key: str
    title: str
    detail: str
    command: str
    seconds: int  # what it usually takes, for the progress
    skippable: bool = False
    skip_note: str = ""
    duration: str = ""
    started: float = 0
    done: bool = False


@dataclass
class Choices:
    mode: str = "full"  # full | overlay | update | remove
    accent: int = 0
    font: int = 2  # dot-matrix everywhere: Nothing Liquid's own look
    login: bool = False
    power: bool = True
    gpu: bool = True  # (NVIDIA laptops) the GPU follows the power profile


def demo_command(key):
    # Stand-ins that exercise each kind of question the real steps can ask
    return {
        "sudo": 'for t in 1 2 3; do read -rs -p "$SUDO_PROMPT" p; echo; [ -n "$p" ] && break; '
                'echo "Sorry, try again."; done; [ -n "$p" ] && echo "(demo: any password works)"',
        "deps": "echo ':: Synchronizing package databases...'; sleep 1; echo ' core is up to date'; "
                "read -p ':: Proceed with installation? [Y/n] ' a; "
                "for i in $(seq 1 40); do printf '\\r(%2d/40) installing demo-package-%02d   [%-40s] %3d%%' "
                "$i $i \"$(head -c $i < /dev/zero | tr '\\0' '#')\" $((i*100/40)); sleep 0.12; done; echo; "
                "read -p ':: demo-a and demo-b are in conflict. Remove demo-b? [y/N] ' a; echo \"answer: $a\"",
        "setups": "echo 'Command \"demo-step\" has failed.'; echo '  r = Repeat this command (DEFAULT)'; "
                  "echo '  e = Exit now'; echo '  i = Ignore this error and continue'; read -p ' [R/e/i]: ' a; "
                  "echo \"answer: $a\"",
        "files": "read -p 'Enter a number (default=1): ' n; echo \"picked ${n:-1}\"; sleep 1",
        "glass": "for f in build link strip install; do echo \"glass: $f\"; sleep 0.6; done",
    }.get(key, "sleep 1; echo done")


def plan(c: Choices, s):
    q = shlex.quote
    R, D = q(str(ROOT)), q(str(ROOT / "dots"))
    me = q(str(Path(__file__).resolve()))
    steps = []
    login = c.login and s["dm"] == "sddm"
    gpu = c.gpu and s["nvidia_hybrid"] and (c.mode in ("full", "overlay") or (c.mode == "update" and s["gpu_power"]))
    removing_system = c.mode == "remove" and (s["login_theme"] or s["power_key"] or s["gpu_power"])
    needs_sudo = c.mode == "full" or login or gpu or (c.power and not s["power_key"]) or removing_system \
        or (c.mode == "overlay" and not s["build_tools"]) or (c.mode == "update" and s["login_theme"])
    if needs_sudo and not DRY:
        steps.append(Step("sudo", "Getting permission",
                          "Your password, once: system packages and settings need it. The rest runs on its own.",
                          "sudo -v && nl_keepalive", 10))
    if c.mode == "update":
        steps.append(Step("pull", "Downloading the latest version", "Fetching what changed since your install.",
                          f"git -C {R} pull --ff-only && git -C {R} submodule update --init --recursive", 30))
    if c.mode == "full":
        flags = "-f --skip-allgreeting" + ("" if s["kde"] else " --skip-plasmaintg")
        steps += [
            Step("deps", "Installing Hyprland and the desktop's apps",
                 "Updating your system, then downloading Hyprland, Quickshell and the apps and fonts the desktop "
                 "uses. Quickshell is built on your computer, so this is the long part: keep it plugged in.",
                 f"cd {D} && bash ./setup install-deps {flags}", 1500, duration="usually 15 to 40 minutes"),
            Step("setups", "Setting up permissions and services",
                 "Brightness and keyboard access, and the background services the desktop talks to.",
                 f"cd {D} && bash ./setup install-setups {flags}", 90, duration="a minute or two"),
            Step("files", "Putting the desktop's settings in place",
                 "Settings for Hyprland, the shell, kitty, fish and more. Your current ones are copied to "
                 "~/ii-original-dots-backup first.",
                 f"cd {D} && bash ./setup install-files {flags}", 40),
        ]
    if gpu:
        steps.append(Step("gpu", "Setting up the NVIDIA graphics",
                          ("" if s["nvidia_driver"] else "NVIDIA's driver, and ") +
                          "the GPU following the power profile: off in power saver, on only for apps that use it "
                          "in balanced. The desktop runs on the integrated GPU.",
                          f"bash {R}/nvidia/install.sh", 20 if s["nvidia_driver"] else 300, skippable=True,
                          skip_note="The NVIDIA GPU stays as it was; run nvidia/install.sh later to set it up."))
    if c.mode == "overlay" and not s["build_tools"]:
        steps.append(Step("tools", "Installing build tools", "What it takes to build the glass for your Hyprland.",
                          "sudo pacman -S --needed --noconfirm base-devel", 60))
    if c.mode in ("full", "overlay", "update"):
        steps.append(Step("glass", "Building the liquid glass",
                          "Building the glass for your Hyprland and putting Nothing Liquid's files in place. "
                          "Files it replaces are kept, so it can be undone.",
                          f"cd {R} && bash ./install.sh" + (" --dry-run" if DRY else ""), 150, skippable=True,
                          skip_note="The desktop works without the glass; run the installer again later to add it."))
    font = FONTS[c.font][1]
    if c.mode in ("full", "overlay"):
        if font != "clean" and not s["doto"]:
            steps.append(Step("font", "Getting the dot-matrix font", "Doto, from Google Fonts.",
                              f"mkdir -p ~/.local/share/fonts && curl -fL --retry 3 -o ~/.local/share/fonts/Doto.ttf "
                              f"{q(DOTO_URL)} && fc-cache -f ~/.local/share/fonts", 15, skippable=True,
                              skip_note="The clean font stays instead."))
        prefs = json.dumps({"accent": ACCENTS[c.accent][1], "font": font})
        steps.append(Step("prefs", "Applying your choices", f"{ACCENTS[c.accent][0]} accent; {FONTS[c.font][0]}.",
                          f"python3 {me} --apply-prefs {q(prefs)}", 3))
    if login or (c.mode == "update" and s["login_theme"]):
        power = int(c.power if c.mode != "update" else s["power_key"])
        steps.append(Step("login", "Installing the login screen",
                          "The glass login screen, with your wallpaper and the brightness and volume keys working there."
                          + (" And the power button: a short press sleeps, holding it shuts down." if power else ""),
                          f"NL_POWER_KEY={power} bash {R}/sddm/install.sh", 40, skippable=True,
                          skip_note="Your current login screen stays."))
    elif c.mode in ("full", "overlay") and c.power and not s["power_key"]:
        steps.append(Step("power", "Setting up the power button", "A short press puts the computer to sleep; "
                          "holding it shuts down.",
                          f"sudo install -D -m 644 {R}/sddm/power-key.conf {POWER_KEY_CONF} && "
                          "sudo systemctl reload systemd-logind", 5, skippable=True))
    if c.mode == "remove":
        steps.append(Step("uninstall", "Removing Nothing Liquid",
                          "Putting back the files it replaced and removing the glass.", f"cd {R} && bash ./uninstall.sh", 20))
        if s["login_theme"]:
            steps.append(Step("login-off", "Putting your old login screen back", "And the power button as it was.",
                              f"bash {R}/sddm/install.sh --uninstall", 20, skippable=True))
        elif s["power_key"]:
            steps.append(Step("power-off", "Putting the power button back", "Any press shuts down again.",
                              f"sudo rm -f {POWER_KEY_CONF} && sudo systemctl reload systemd-logind", 5, skippable=True))
        if s["gpu_power"]:
            steps.append(Step("gpu-off", "Putting the NVIDIA GPU back as it was",
                              "It stays on demand, and Hyprland uses it again from the next login. "
                              "NVIDIA's driver stays.", f"bash {R}/nvidia/install.sh --uninstall", 10, skippable=True))
    steps.append(Step("finish", "Finishing up", "Tidying up.", "nl_finish", 2))
    if DEMO:
        for st in steps:
            st.command = demo_command(st.key) if st.key != "finish" else "nl_finish"
            st.seconds = 8
    elif DRY:
        for st in steps:
            if st.key in ("deps", "setups", "files", "tools", "font", "prefs", "login", "power",
                          "pull", "uninstall", "login-off", "power-off", "gpu", "gpu-off"):
                st.command = f"echo {q('would run: ' + st.command)}; sleep 1"
    return steps


class Window(RunnerUI, Adw.ApplicationWindow):
    def __init__(self, app):
        super().__init__(application=app, title="Nothing Liquid", default_width=880, default_height=760)
        self.set_size_request(380, 520)
        self.system = None
        self.choices = Choices()
        self.steps = []
        self.index = 0
        self.runner = None
        self.running = False
        self.closing = False
        self.log_path = None
        LOGS.mkdir(parents=True, exist_ok=True)
        self.toasts = Adw.ToastOverlay()
        self.nav = Adw.NavigationView()
        self.toasts.set_child(self.nav)
        self.set_content(self.toasts)
        self.demo = DEMO
        self.nav.push(self.first_boot_page() if FIRST_BOOT else self.welcome_page())
        self.connect("close-request", self.on_close_request)

    # ── the first start after the USB installer ──
    def first_boot_page(self):
        box = column()
        dot = Gtk.Box(halign=Gtk.Align.CENTER)
        dot.add_css_class("nl-dot")
        box.append(dot)
        box.append(label("ALMOST THERE", "nl-title", xalign=0.5))
        box.append(label("Arch Linux is installed. Now the desktop: Hyprland, its shell and the glass. It takes "
                         "20 to 40 minutes and needs the internet; it asks for your password once.", "nl-lead",
                         xalign=0.5))
        status = label("Checking the internet…", "dim-label", xalign=0.5)
        box.append(status)
        wifi = Adw.PreferencesGroup(title="Wi-Fi")
        wifi.set_visible(False)
        box.append(wifi)
        start = big_button("Start")
        start.set_sensitive(False)
        start.connect("clicked", lambda *_: self.first_boot_start())
        box.append(start)
        box.append(label("If it gets stuck: Ctrl+Alt+F2 opens a text console (log in with your username and "
                         "password), Ctrl+Alt+F1 comes back here.", "caption", "dim-label", xalign=0.5))
        rows = []
        state = {"tries": 0}

        def ready(system):
            self.system = system
            status.set_label("Online.")
            wifi.set_visible(False)
            start.set_sensitive(True)
            start.grab_focus()

        def offline(nets):
            status.set_label("Not online yet. Plug in a network cable, or pick your Wi-Fi.")
            for r in rows:
                wifi.remove(r)
            rows.clear()
            for name, secured in nets:
                row = Adw.ActionRow(title=name, subtitle="Password" if secured else "Open", activatable=True)
                row.connect("activated", lambda _r, n=name, sec=secured: self.join_wifi(n, sec, status))
                wifi.add(row)
                rows.append(row)
            wifi.set_visible(bool(nets))

        def poll():
            if self.system or self.running:
                return False
            state["tries"] += 1

            def work():
                if reachable("archlinux.org") or reachable("github.com"):
                    GLib.idle_add(ready, detect())
                elif state["tries"] % 5 == 2:  # now and then, the Wi-Fi around
                    listed = out(["nmcli", "-t", "-f", "SSID,SECURITY", "dev", "wifi", "list", "--rescan", "yes"])
                    nets = []
                    for line in listed.splitlines():
                        name, _, sec = line.rpartition(":")
                        name = name.replace("\\:", ":")
                        if name and name not in [n for n, _ in nets]:
                            nets.append((name, bool(sec.strip())))
                    GLib.idle_add(offline, nets)
            threading.Thread(target=work, daemon=True).start()
            return True
        poll()
        GLib.timeout_add_seconds(3, poll)
        return page("Setting up", box, "first-boot", header_title=False)

    def join_wifi(self, name, secured, status):
        def go(password=None):
            status.set_label(f"Connecting to {name}…")
            cmd = ["nmcli", "dev", "wifi", "connect", name] + (["password", password] if password else [])
            threading.Thread(target=lambda: subprocess.run(cmd, capture_output=True), daemon=True).start()
        if not secured:
            go()
            return
        dialog = Adw.AlertDialog(heading=name, body="The Wi-Fi password:")
