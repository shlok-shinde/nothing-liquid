# ── preferences (also run headless: --apply-prefs) ───────────────────────────
def apply_prefs(spec):
    """Accent and fonts into the shell's config; the shell picks it up live."""
    prefs = json.loads(spec)
    cfg = json.loads(CONFIG.read_text()) if CONFIG.exists() else {}
    appearance = cfg.setdefault("appearance", {})
    glass = appearance.setdefault("liquidGlass", {})
    if "accent" in prefs:
        glass["accentColor"] = prefs["accent"]
        print(f"accent: {prefs['accent'] or 'your wallpaper colours'}")
    font = prefs.get("font", "clean")
    if font != "clean":
        families = subprocess.run(["fc-list", ":", "family"], capture_output=True, text=True).stdout
        names = {n.strip() for line in families.splitlines() for n in line.split(",")}
        doto = next((n for n in ("Doto Black", "Doto") if n in names), None)
        if doto:
            keys = ("title", "numbers", "expressive") if font == "titles" else \
                   ("main", "title", "numbers", "expressive", "monospace")
            fonts = appearance.setdefault("fonts", {})
            for k in keys:
                fonts[k] = doto
            print(f"fonts: {', '.join(keys)} in {doto}")
        else:
            print("the dot-matrix font isn't installed, so the fonts stay as they are")
    CONFIG.parent.mkdir(parents=True, exist_ok=True)
    CONFIG.write_text(json.dumps(cfg, indent=2))


if len(sys.argv) > 2 and sys.argv[1] == "--apply-prefs":
