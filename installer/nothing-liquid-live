    def fill_disks(self, holder, found):
        first_radio = None
        usable = 0
        for d in found:
            group = Adw.PreferencesGroup(title=d["model"], description=f"{d['path']} · {size(d['size'])}")
            bar = self.disk_bar(d)
            options = []
            free_ok = d["gpt"] and max(d["free"], d["free_again"]) >= nldisks.MIN_BYTES
            if free_ok:
                room = max(d["free"], d["free_again"])
                if d["ours"]:
                    t, sub = "Replace the earlier Nothing Liquid", f"Uses its space and the free space: {size(room)}."
                elif d["windows"]:
                    t, sub = "Next to Windows", f"In the {size(room)} of free space. Windows and your files stay as they are."
                else:
                    t, sub = "In the free space", f"Uses the {size(room)} that's free. What's on the disk stays."
                options.append(("free", t, sub, False))
            if d["empty"]:
                options.append(("whole", "Use this empty disk", f"All {size(d['size'])} of it.", False))
            else:
                what = "Windows and everything else on it" if d["windows"] else "Everything on it"
                options.append(("whole", "Erase this disk", f"{what} is deleted. All {size(d['size'])} for Nothing Liquid.",
                                True))
            rows = [self.bar_row(bar)]
            for mode, t, sub, danger in options:
                row = Adw.ActionRow(title=t, subtitle=sub)
                row.set_subtitle_lines(0)
                radio = Gtk.CheckButton(valign=Gtk.Align.CENTER)
                if first_radio:
                    radio.set_group(first_radio)
                else:
                    first_radio = radio
                radio.connect("toggled", self.on_disk_choice, d, mode, danger)
                row.add_prefix(radio)
                row.set_activatable_widget(radio)
                if danger:
                    row.add_css_class("error")
                rows.append(row)
                usable += 1
                if mode == "free" and not self.choice["disk"]:
                    radio.set_active(True)
            if d["windows"] and not free_ok:
                rows.append(self.note_row("warn", "No room next to Windows yet",
                                          "In Windows: right-click Start › Disk Management, right-click C: › Shrink "
                                          "Volume, and shrink it by 60 GB or more. Then start this USB again."
                                          if d["gpt"] else "This disk uses the older MBR layout, so Linux can't go "
                                          "next to Windows on it."))
            if d["bitlocker"]:
                rows.append(self.note_row("warn", "Windows uses BitLocker here",
                                          "Have your BitLocker recovery key ready (aka.ms/myrecoverykey): Windows may "
                                          "ask for it the next time it starts."))
            for r in rows:
                group.add(r)
            holder.append(group)
        if not found:
            holder.append(label("No disk of 30 GB or more was found.", "error", xalign=0.5))
        self.disk_next.set_sensitive(usable > 0 and self.choice["disk"] is not None)
        if not self.choice["disk"] and first_radio:
            first_radio.set_active(True)

    def note_row(self, level, title, sub):
        row = Adw.ActionRow(title=title, subtitle=sub)
        row.set_subtitle_lines(0)
        row.add_prefix(status_dot(level))
        return row

    def bar_row(self, bar):
        row = Adw.PreferencesRow(activatable=False)
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=6)
        for m in ("top", "bottom", "start", "end"):
            getattr(box, f"set_margin_{m}")(12)
        box.append(bar)
        row.set_child(box)
        return row

    def disk_bar(self, d):
        """The disk drawn to scale: Windows dark, other partitions grey, free space as
        dots, an earlier Nothing Liquid red."""
        area = Gtk.DrawingArea(content_height=22, hexpand=True)
        total = max(d["sectors"], 1)

        def draw(_a, cr, w, h):
            fg = area.get_color()
            r = 6
            cr.save()
            cr.new_sub_path()
            for (x, y, a1, a2) in ((w - r, r, -1.5708, 0), (w - r, h - r, 0, 1.5708), (r, h - r, 1.5708, 3.1416),
                                   (r, r, 3.1416, 4.7124)):
                cr.arc(x, y, r, a1, a2)
            cr.close_path()
            cr.clip()
            cr.set_source_rgba(fg.red, fg.green, fg.blue, 0.06)
            cr.paint()
            for x in range(4, int(w), 8):  # free space: Nothing's dots
                cr.set_source_rgba(fg.red, fg.green, fg.blue, 0.22)
                cr.arc(x, h / 2, 1.3, 0, 6.2832)
                cr.fill()
            for start, length, name in d["layout"]:
                x0, x1 = w * start / total, max(w * (start + length) / total, w * start / total + 2)
                if name in nldisks.OURS:
                    cr.set_source_rgba(0.84, 0.10, 0.13, 1)
                elif "Basic data" in name or "Microsoft" in name or "Recovery" in name:
                    cr.set_source_rgba(fg.red, fg.green, fg.blue, 0.55)
                else:
                    cr.set_source_rgba(fg.red, fg.green, fg.blue, 0.35)
                cr.rectangle(x0, 0, x1 - x0 - 1, h)
                cr.fill()
            cr.restore()
        area.set_draw_func(draw)
        return area

    def on_disk_choice(self, radio, d, mode, danger):
        if radio.get_active():
            self.choice.update(disk=d, mode=mode, danger=danger)
            self.disk_next.set_sensitive(True)

    def confirm_disk(self):
        d = self.choice["disk"]
        if not self.choice.get("danger"):
            self.show_you()
            return
        dialog = Adw.AlertDialog(heading=f"Erase {d['model']}?",
                                 body=("Windows, its files and everything else on this disk will be deleted, and "
                                       "can't be brought back." if d["windows"] else
                                       "Everything on this disk will be deleted, and can't be brought back.")
                                 + "\n\nType ERASE to confirm.")
        entry = Gtk.Entry(activates_default=True)
        dialog.set_extra_child(entry)
        dialog.add_response("cancel", "Cancel")
        dialog.add_response("erase", "Erase it")
        dialog.set_response_appearance("erase", Adw.ResponseAppearance.DESTRUCTIVE)
        dialog.set_response_enabled("erase", False)
        dialog.set_default_response("cancel")
        dialog.set_close_response("cancel")
        entry.connect("changed", lambda e: dialog.set_response_enabled("erase", e.get_text().strip() == "ERASE"))
        dialog.connect("response", lambda _d, rid: rid == "erase" and self.show_you())
        dialog.present(self)
        entry.grab_focus()

    # ── you ──
    def show_you(self):
        if self.nav.find_page("you"):
            self.nav.pop_to_tag("you")
            return
        box = column()
        box.append(label("About you", "nl-heading"))
        who = Adw.PreferencesGroup()
        name = Adw.EntryRow(title="Your name")
        user = Adw.EntryRow(title="Username (for logging in)")
        host = Adw.EntryRow(title="This computer's name")
        pw = Adw.PasswordEntryRow(title="Password")
        pw2 = Adw.PasswordEntryRow(title="Password again")
        for r in (name, user, host, pw, pw2):
            who.add(r)
        box.append(who)
        more = Adw.PreferencesGroup()
        zones = getattr(self, "zones", None) or timezones()
        guess = getattr(self, "zone_guess", None)
        zone = Adw.ComboRow(title="Time zone", model=Gtk.StringList.new(zones), enable_search=True)
        start_zone = guess if guess in zones else "UTC"
        if start_zone in zones:
            zone.set_selected(zones.index(start_zone))
        if guess not in zones and not DEMO:  # (no internet yet when it opened, before Wi-Fi): ask again
            def late(tz):
                picked = zone.get_selected()
                untouched = picked >= len(zones) or zones[picked] == start_zone  # (they didn't pick one meanwhile)
                if tz in zones and untouched:
                    self.zone_guess = tz
                    zone.set_selected(zones.index(tz))

            threading.Thread(target=lambda: GLib.idle_add(late, guess_timezone()), daemon=True).start()
        enc = Adw.SwitchRow(title="Encrypt Nothing Liquid",
                            subtitle="Your files can't be read without the password, even with the disk taken out. "
                                     "The computer asks for it every time it starts.")
        more.add(zone)
        more.add(enc)
        box.append(more)
        warn = label("", "caption", "warning")
        warn.set_visible(False)
        box.append(warn)
        problem = label("", "caption", "error")
        box.append(problem)
        nxt = big_button("Next")
        box.append(nxt)
        auto = {"user": "", "host": ""}  # what was filled in for them: once they type their own, it stays

        def slug(text):
            return re.sub(r"[^a-z0-9]", "", text.lower().split(" ")[0])[:20]

        def on_name(*_):
            for row, key, value in ((user, "user", slug(name.get_text())),
                                    (host, "host", (slug(name.get_text()) or "my") + "-pc")):
                if row.get_text() == auto[key]:
                    auto[key] = value
                    row.set_text(value)
            check()

        def check(*_):
            msg = ""
            if not name.get_text().strip():
                msg = "What's your name?"
            elif not re.fullmatch(r"[a-z_][a-z0-9_-]{0,31}", user.get_text()):
                msg = "The username: small letters and numbers, starting with a letter."
            elif not re.fullmatch(r"[A-Za-z0-9][A-Za-z0-9-]{0,62}", host.get_text()):
                msg = "The computer's name: letters, numbers and dashes."
            elif len(pw.get_text()) < 4:
                msg = "A password of at least 4 characters."
            elif pw.get_text() != pw2.get_text():
                msg = "The two passwords don't match yet."
            problem.set_label(msg)
            nxt.set_sensitive(not msg)
            us_like = self.xkb in ("us", "gb", "ca", "au", "nz", "ie", "in", "za", "ph")
            warn.set_visible(enc.get_active() and not us_like)
            warn.set_label("With encryption, the password is typed when the computer starts, before your keyboard "
                           "layout is loaded: there it reads as a US (QWERTY) keyboard. Pick a password whose keys "
                           "are in the same place on both, or leave encryption off.")
        name.connect("changed", on_name)
        for r in (user, host, pw, pw2):
            r.connect("changed", check)
        enc.connect("notify::active", check)
        check()

        def go(*_):
            self.choice.update(name=name.get_text().strip(), user=user.get_text(), host=host.get_text(),
                               password=pw.get_text(), zone=zones[zone.get_selected()], encrypt=enc.get_active())
            self.show_look()
        nxt.connect("clicked", go)
        pw2.connect("entry-activated", lambda *_: nxt.get_sensitive() and go())  # Enter, when it's all filled in
        p = self.page("You", box, "you")
        p.connect("shown", lambda *_: name.grab_focus())
        self.nav.push(p)

    # ── look ──
