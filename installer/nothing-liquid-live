    # ── summary ──
    def show_summary(self):
        c = self.choice
        d = c["disk"]
        box = column()
        box.append(label("Ready to install", "nl-heading"))
        g = Adw.PreferencesGroup()
        if c["mode"] == "free":
            room = max(d["free"], d["free_again"])
            where = (f"replaces the earlier Nothing Liquid on {d['model']}, with the free space: {size(room)}. "
                     if d["ours"] else f"goes in the {size(room)} of free space on {d['model']}. ")
            disk_line = ("Nothing Liquid " + where
                         + ("Windows and your files aren't touched." if d["windows"] else "What's there stays."))
        elif d["empty"]:
            disk_line = f"Nothing Liquid gets all of {d['model']} ({size(d['size'])}), which is empty."
        else:
            disk_line = f"{d['model']} is erased: everything on it is deleted, then it's all Nothing Liquid."
        rows = [("Disk", disk_line),
                ("You", f"{c['name']}, logging in as {c['user']}, on “{c['host']}”"),
                ("Time and keyboard", f"{c['zone']} · {self.xkb} keyboard"),
                ("Encryption", "On: the password is asked when the computer starts" if c["encrypt"] else "Off"),
                ("Look", f"{ACCENTS[c['accent']][0]} · {FONTS[c['font']][0]}"),
                ("After this", "The computer restarts into Nothing Liquid, which finishes setting itself up the "
                               "first time (20 to 40 minutes, online).")]
        for i, (t, sub) in enumerate(rows, 1):
            row = Adw.ActionRow(title=t, subtitle=sub)
            row.set_subtitle_lines(0)
            row.add_prefix(label(f"{i:02d}", "nl-num", wrap=False))
            g.add(row)
        box.append(g)
        go = big_button("Install", "destructive-action" if c.get("danger") else "suggested-action")
        go.connect("clicked", lambda *_: self.install())
        box.append(go)
        p = self.page("Summary", box, "summary")
        p.connect("shown", lambda *_: go.grab_focus())
        self.nav.push(p)

    # ── installing ──
    def install(self):
        box = column(14)
        self.kicker = label("", "nl-kicker")
        self.step_title = label("Starting", "nl-heading")
        self.step_detail = label("", "dim-label")
        self.dots = DotProgress()
        self.elapsed = label("", "caption", "dim-label", wrap=False)
        for w in (self.kicker, self.step_title, self.step_detail, self.dots, self.elapsed):
            box.append(w)
        box.append(self.make_log(300))
        self.nav.push(self.page("Installing", box, "progress", can_pop=False))
        self.log_path = RUN / f"install-{time.strftime('%Y%m%d-%H%M%S')}.log"
        self.run_install()

    def run_install(self):
        c = self.choice
        secret = RUN / "secret"
        fd = os.open(secret, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
        os.write(fd, c["password"].encode())
        os.close(fd)
        env = {
            "NL_DISK": c["disk"]["path"], "NL_MODE": c["mode"], "NL_USER": c["user"], "NL_FULLNAME": c["name"],
            "NL_HOST": c["host"], "NL_TZ": c["zone"], "NL_XKB": self.xkb, "NL_KEYMAP": console_keymap(self.xkb),
            "NL_ENCRYPT": "1" if c["encrypt"] else "0", "NL_SECRET": str(secret), "NL_REPO": str(ROOT),
            "NL_PREFS": json.dumps({"accent": ACCENTS[c["accent"]][1], "font": FONTS[c["font"]][1],
                                    "login": c["login"], "power": c["power"]}),
        }
        script = HERE / "live/install-system.sh"
        if DEMO:
            script = HERE / "live/demo-install.sh"
        command = " ".join(f"{k}={shlex.quote(v)}" for k, v in env.items()) + f" bash {shlex.quote(str(script))}"
        self.step_index = 0
        self.step_started = time.time()
        self.started = time.time()
        self.running = True
        self.runner = Runner(self.log_path, self.on_line, self.on_live, lambda: self.runner.run(command),
                             self.on_done, self.on_prompt, self.on_exit, cwd=str(ROOT))
        self.runner.start()
        GLib.timeout_add(500, self.tick)

    def on_line(self, line):
        m = re.fullmatch(r"@@NLSTEP (\S+)@@", line.strip())
        if m:
            keys = [s[0] for s in STEPS]
            if m.group(1) in keys:
                self.step_index = keys.index(m.group(1))
                self.step_started = time.time()
                _, title, detail, _ = STEPS[self.step_index]
                self.kicker.set_label(f"STEP {self.step_index + 1} OF {len(STEPS)}")
                self.step_title.set_label(title)
                self.step_detail.set_label(detail)
            return
        super().on_line(line)

    def tick(self):
        if not self.running:
            return False
        total = sum(s[3] for s in STEPS)
        done = sum(s[3] for s in STEPS[:self.step_index])
        cur = STEPS[self.step_index][3]
        done += cur * min(0.92, (time.time() - self.step_started) / cur)
        self.dots.set_fraction(done / total)
        m, s = divmod(int(time.time() - self.started), 60)
        self.elapsed.set_label(f"{m}:{s:02d}")
        return True

    def on_done(self, code):
        self.drop_dialog()
        if not self.running:
            return
        self.running = False
        if code == 0:
            self.choice["password"] = ""
            self.dots.set_fraction(1)
            self.show_done()
        else:
            self.show_failed(code)

    def on_exit(self):
        if self.running:
            self.running = False
            self.show_failed(-1)

    def show_done(self):
        box = column(16)
        dot = Gtk.Box(halign=Gtk.Align.CENTER)
        dot.add_css_class("nl-dot")
        box.append(dot)
        box.append(label("INSTALLED", "nl-title", xalign=0.5))
        box.append(label("Take out the USB stick, then restart.", "nl-lead", xalign=0.5))
        g = Adw.PreferencesGroup()
        for i, (t, sub) in enumerate([
                ("It starts Nothing Liquid", "A menu shows for a few seconds first: Nothing Liquid, its snapshots, "
                                             "and Windows. Pick Windows there to start Windows."),
                ("The first start finishes the desktop", "20 to 40 minutes, online. It asks for your password once."),
                ("If it starts Windows instead", "Restart and press the boot menu key as it turns on (often F12, F11, "
                                                 "F9 or Esc), then pick Nothing Liquid.")], 1):
            row = Adw.ActionRow(title=t, subtitle=sub)
            row.set_subtitle_lines(0)
            row.add_prefix(label(f"{i:02d}", "nl-num", wrap=False))
            g.add(row)
        box.append(g)
        restart = big_button("Restart now")
        restart.connect("clicked", lambda *_: self.power("reboot"))
        box.append(restart)
        p = self.page("Installed", box, "done", can_pop=False, header_title=False)
        p.connect("shown", lambda *_: restart.grab_focus())
        self.nav.push(p)

    def show_failed(self, code):
        box = column(16)
        box.append(label("THAT DIDN'T WORK", "nl-title", xalign=0.5))
        title = STEPS[self.step_index][1]
        box.append(label(f"“{title}” stopped. Windows and the rest of the disk are as they were, apart from the "
                         "space Nothing Liquid was going into.", "nl-lead", xalign=0.5))
        tail = [line for line in (self.runner.recent if self.runner else []) if line.strip()][-14:]
        if tail:
            box.append(self.detail_box("\n".join(tail)))
        if STEPS[self.step_index][0] == "base":
            box.append(label("Usually that's the internet: check it and try again.", "dim-label", xalign=0.5))
        buttons = Gtk.Box(spacing=12, halign=Gtk.Align.CENTER)
        again = big_button("Try again")
        again.connect("clicked", lambda *_: self.retry())
        buttons.append(again)
        back = big_button("Change something", "flat")
        back.connect("clicked", lambda *_: self.nav.pop_to_tag("summary"))
        buttons.append(back)
        box.append(buttons)
        box.append(label(f"The full log: {self.log_path}", "caption", "dim-label", xalign=0.5, selectable=True))
        p = self.page("Stopped", box, "failed", can_pop=False)
        p.connect("shown", lambda *_: again.grab_focus())
        self.nav.push(p)

    def retry(self):
        self.nav.pop_to_tag("progress")
        if self.runner:
            self.runner.close()
        self.run_install()

    def power(self, what):
        if DEMO:
            self.get_application().quit()
            return
        subprocess.Popen(["systemctl", what])


class App(Adw.Application):
    quit_code = 0

    def __init__(self):
        super().__init__(application_id="io.github.shlok_shinde.NothingLiquid.Live",
                         flags=Gio.ApplicationFlags.NON_UNIQUE)
        self.connect("activate", self.on_activate)
        for name, what in (("restart", "reboot"), ("poweroff", "poweroff")):
            action = Gio.SimpleAction.new(name, None)
            action.connect("activate", lambda *_a, w=what: self.window.power(w))
            self.add_action(action)

    def on_activate(self, app):
        Adw.StyleManager.get_default().set_color_scheme(Adw.ColorScheme.FORCE_DARK)
        load_css()
        self.window = Window(self)
        self.window.present()
        if not DEMO:
            self.window.maximize()


if __name__ == "__main__":
    if not DEMO and os.geteuid() != 0:
        sys.exit("The USB installer runs as root, on the Nothing Liquid USB. To look at it anywhere: --demo")
    app = App()
    app.run([a for a in sys.argv if not a.startswith("--")])
    sys.exit(app.quit_code)
