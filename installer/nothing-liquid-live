        login = Adw.SwitchRow(title="Glass login screen", subtitle="The login screen gets the same glass.",
                              active=self.choice["login"])
        login.connect("notify::active", lambda r, _: self.choice.update(login=r.get_active()))
        power = Adw.SwitchRow(title="Power button sleeps", subtitle="A short press sleeps; hold it to shut down.",
                              active=self.choice["power"])
