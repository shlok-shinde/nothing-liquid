def size(b):
    return f"{b / 1e12:.1f} TB" if b >= 1e12 else f"{b / 1e9:.0f} GB"


def online():
    for host in ("archlinux.org", "github.com"):
        try:
            socket.create_connection((host, 443), timeout=3).close()
            return True
        except OSError:
            pass
    return False


def xkb_layouts():
    """(code, name) for every keyboard layout, from xkeyboard-config's list."""
    names = {}
    try:
        section = None
        for line in open("/usr/share/X11/xkb/rules/evdev.lst"):
            if line.startswith("!"):
                section = line.strip()
            elif section == "! layout" and line.strip():
                code, _, desc = line.strip().partition(" ")
                names[code] = desc.strip()
    except OSError:
        names = {"us": "English (US)"}
    return sorted(names.items(), key=lambda kv: (kv[0] != "us", kv[1]))


def console_keymap(xkb):
    """The text console's keymap closest to an XKB layout (us when there's none)."""
    special = {"gb": "uk", "ch": "de_CH-latin1", "latam": "la-latin1", "br": "br-abnt2", "ca": "cf",
               "pt": "pt-latin1", "se": "sv-latin1", "dk": "dk-latin1", "fi": "fi", "no": "no-latin1"}
    if xkb in special:
        return special[xkb]
    return xkb if glob.glob(f"/usr/share/kbd/keymaps/**/{xkb}.map.gz", recursive=True) else "us"


def timezones():
    try:
        zones = subprocess.run(["timedatectl", "list-timezones"], capture_output=True, text=True).stdout.split()
    except OSError:
        zones = []
    return zones or ["UTC"]


def guess_timezone():
    # Two services, since either may turn a request away (ipapi.co rate-limits)
    for url in ("https://ipinfo.io/timezone", "https://ipapi.co/timezone"):
        try:
            tz = subprocess.run(["curl", "-fsS", "--max-time", "4", url],
                                capture_output=True, text=True).stdout.strip()
        except OSError:
            return None
        if re.fullmatch(r"[A-Za-z_]+(/[A-Za-z0-9_+-]+)*", tz):
            return tz
    return None


