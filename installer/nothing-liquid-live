    # ── internet ──
    def show_network(self):
        if DEMO or online():
            self.show_disks()
            return
        box = column()
        box.append(label("Get online", "nl-heading"))
        box.append(label("Installing downloads the system, so the computer needs the internet. "
                         "A network cable works by itself; or pick your Wi-Fi.", "dim-label"))
        group = Adw.PreferencesGroup(title="Wi-Fi")
        box.append(group)
        status = label("", "dim-label", xalign=0.5)
        box.append(status)
        rescan = Gtk.Button(label="Look again", halign=Gtk.Align.CENTER)
        rescan.add_css_class("flat")
        box.append(rescan)
        p = self.page("Internet", box, "network")
        self.nav.push(p)
        rows = []
        try:
            wifi = WiFi()
        except GLib.Error:
            wifi = None

        def fill(nets):
            for r in rows:
                group.remove(r)
            rows.clear()
            if wifi is None or wifi.station()[0] is None:
                status.set_label("No Wi-Fi on this computer (or its driver isn't on the USB): use a network cable.")
            elif not nets:
                status.set_label("No networks found yet…")
            else:
                status.set_label("")
            for net in nets:
                row = Adw.ActionRow(title=net["name"], subtitle=("Connected" if net["connected"] else
                                    {"open": "Open", "psk": "Password"}.get(net["type"], "Enterprise (not supported)")))
                row.add_suffix(label("●" * net["bars"] + "○" * (4 - net["bars"]), "dim-label", wrap=False))
                row.set_activatable(net["type"] in ("open", "psk"))
                row.connect("activated", lambda _r, n=net: self.join(wifi, n, status))
                group.add(row)
                rows.append(row)
            if online():
                self.show_disks()

        def refresh(*_):
            status.set_label("Looking for networks…")

            def work():
                if wifi:
                    wifi.scan()
                    time.sleep(3)
                nets = wifi.networks() if wifi and wifi.station()[0] else []
                GLib.idle_add(fill, nets)
            threading.Thread(target=work, daemon=True).start()
        rescan.connect("clicked", refresh)
        refresh()

        def watch():  # a cable plugged in meanwhile
            if self.nav.get_visible_page() is not p:
                return False
            if online():
                self.show_disks()
                return False
            return True
        GLib.timeout_add_seconds(4, watch)

    def join(self, wifi, net, status):
        def go(passphrase=None):
            status.set_label(f"Connecting to {net['name']}…")

            def work():
                ok = wifi.connect(net["name"], passphrase)
                for _ in range(10):
                    if ok and online():
                        break
                    time.sleep(1)
                GLib.idle_add(done, ok and online())
            threading.Thread(target=work, daemon=True).start()

        def done(ok):
            if ok:
                self.show_disks()
            else:
                status.set_label(f"Couldn't connect to {net['name']}. Check the password and try again.")
        if net["type"] == "open":
            go()
            return
        dialog = Adw.AlertDialog(heading=net["name"], body="The Wi-Fi password:")
        entry = Gtk.PasswordEntry(show_peek_icon=True, activates_default=True)
        dialog.set_extra_child(entry)
        dialog.add_response("cancel", "Cancel")
        dialog.add_response("ok", "Connect")
        dialog.set_response_appearance("ok", Adw.ResponseAppearance.SUGGESTED)
        dialog.set_default_response("ok")
        dialog.set_close_response("cancel")
        dialog.connect("response", lambda d, rid: rid == "ok" and go(entry.get_text()))
        dialog.present(self)
        entry.grab_focus()

