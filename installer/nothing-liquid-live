class WiFi:
    """iwd's networks over D-Bus; connecting through iwctl (it takes the password
    as an argument, so no D-Bus agent is needed)."""

    def __init__(self):
        self.bus = Gio.bus_get_sync(Gio.BusType.SYSTEM, None)

    def _objects(self):
        reply = self.bus.call_sync("net.connman.iwd", "/", "org.freedesktop.DBus.ObjectManager",
                                   "GetManagedObjects", None, None, Gio.DBusCallFlags.NONE, 5000, None)
        return reply.unpack()[0]

    def station(self):
        for path, ifaces in self._objects().items():
            if "net.connman.iwd.Station" in ifaces:
                return path, ifaces.get("net.connman.iwd.Device", {}).get("Name", "wlan0")
        return None, None

    def scan(self):
        path, _ = self.station()
        if path:
            try:
                self.bus.call_sync("net.connman.iwd", path, "net.connman.iwd.Station", "Scan",
                                   None, None, Gio.DBusCallFlags.NONE, 5000, None)
            except GLib.Error:
                pass  # already scanning

    def networks(self):
        path, _ = self.station()
        if not path:
            return []
        objects = self._objects()
        ordered = self.bus.call_sync("net.connman.iwd", path, "net.connman.iwd.Station", "GetOrderedNetworks",
                                     None, None, Gio.DBusCallFlags.NONE, 5000, None).unpack()[0]
        found = []
        for net_path, strength in ordered:
            net = objects.get(net_path, {}).get("net.connman.iwd.Network", {})
            if net.get("Name"):
                found.append({"name": net["Name"], "type": net.get("Type", "psk"),
                              "connected": bool(net.get("Connected")), "bars": max(1, min(4, (strength // 100 + 100) // 15))})
        return found

    def connect(self, name, passphrase=None):
        _, dev = self.station()
        cmd = ["iwctl"] + (["--passphrase", passphrase] if passphrase else []) + ["station", dev, "connect", name]
        r = subprocess.run(cmd, capture_output=True, text=True, timeout=40)
        return r.returncode == 0


class Window(RunnerUI, Adw.ApplicationWindow):
